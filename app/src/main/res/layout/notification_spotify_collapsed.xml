<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/bg_spotify_notification"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <!-- Station Artwork / Album Art (Rounded, Spotify style) -->
    <ImageView
        android:id="@+id/notif_art"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_spotify_art_placeholder"
        android:contentDescription="İstasyon Logosu"
        android:scaleType="centerCrop"
        android:src="@drawable/vizyontv_logo_1791312957832" />

    <!-- Station Info (Title + Green CANLI Badge + VİZYON TV) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:text="Canlı Radyo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_badge_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● CANLI"
                android:textColor="#1DB954"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text=" • VİZYON TV"
                android:textColor="#B3B3B3"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spotify-style Media Controls: Prev, Green Round Play/Pause, Next -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Önceki İstasyon"
            android:padding="5dp"
            android:src="@drawable/ic_spotify_prev" />

        <ImageView
            android:id="@+id/notif_btn_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_spotify_play_circle"
            android:contentDescription="Oynat / Duraklat"
            android:padding="9dp"
            android:src="@drawable/ic_spotify_pause" />

        <ImageView
            android:id="@+id/notif_btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sonraki İstasyon"
            android:padding="5dp"
            android:src="@drawable/ic_spotify_next" />
    </LinearLayout>

</LinearLayout>
